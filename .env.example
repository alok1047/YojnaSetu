# =============================================================================
# YojnaSetu Environment Variables
# =============================================================================

# AI Provider: 'gemini' (recommended) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Configuration (Recommended)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# (Optional) OpenAI API Configuration
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Administrator Passcode for /admin
ADMIN_SECRET=admin123

